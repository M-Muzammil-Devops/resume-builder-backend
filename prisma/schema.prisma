generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String?
  role             String            @default("user")
  location         String?
  country          String?
  city             String?
  /// ACTIVE | SUSPENDED | DELETED (soft delete). Only ACTIVE accounts can sign in.
  status           String            @default("ACTIVE")
  /// FREE | PRO (billing plan shown in the admin console).
  plan             String            @default("FREE")
  suspendedAt      DateTime?
  deletedAt        DateTime?
  lastLoginAt      DateTime?
  emailVerifiedAt  DateTime?
  sessionEpoch     Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  resumes          Resume[]
  coverLetters     CoverLetter[]
  applications     JobApplication[]
  autoApplyConfig  AutoApplyConfig?
  autoApplyCredits AutoApplyCredit?
  loginEvents      LoginEvent[]
  authTokens       AuthToken[]
  exportEvents     ExportEvent[]
  oauthAccounts    OAuthAccount[]

  @@index([role])
  @@index([status])
  @@index([plan])
  @@index([country])
  @@index([createdAt])
  @@index([lastLoginAt])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/** SSO link: one row per provider identity (Google sub / Facebook id), linked by verified email. */
model OAuthAccount {
  id             String   @id @default(cuid())
  provider       String
  providerUserId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String?
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model LoginEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip          String?
  country     String?
  city        String?
  userAgent   String?
  /// Filled offline from ip / userAgent (src/lib/activity.ts); null until enriched.
  region      String?
  countryCode String?
  browser     String?
  os          String?
  /// desktop | mobile | tablet | bot | unknown
  device      String?
  enrichedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([country])
  @@index([device])
  @@index([enrichedAt])
}

/// Cookie-consent audit trail: one row per choice saved in the banner or the preferences modal.
model ConsentLog {
  id          String   @id @default(cuid())
  anonId      String
  userId      String?
  version     Int
  preferences Boolean  @default(false)
  analytics   Boolean  @default(false)
  marketing   Boolean  @default(false)
  /// accept_all | reject_all | custom
  action      String
  createdAt   DateTime @default(now())

  @@index([anonId])
  @@index([createdAt])
}

/// Page views, recorded only when the visitor's consent cookie allows analytics. No IP is stored.
model PageView {
  id        String   @id @default(cuid())
  anonId    String
  userId    String?
  path      String
  referrer  String?
  device    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([userId])
}

/// Admin overrides for the built-in landing templates (frontend src/lib/landingTemplates.ts).
model TemplateSetting {
  id          String   @id
  name        String?
  category    String?
  description String?
  isActive    Boolean  @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// One row per successful resume export (PDF/DOCX/TXT); drives usage counts and plan limits.
model ExportEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId   String?
  templateId String?
  format     String
  pageSize   String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resumeId])
  @@index([createdAt])
}

/// Key/value admin settings (e.g. "export" = PDF export settings).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Every admin write action (template, resume, settings changes).
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String
  targetType String
  targetId   String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@index([targetType, targetId])
}

model Resume {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  templateId  String
  layoutKey   String
  content     Json
  design      Json
  isComplete     Boolean       @default(false)
  shareEnabled   Boolean       @default(false)
  shareToken     String?       @unique
  shareExpiresAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  coverLetter CoverLetter?

  @@index([userId])
}

model CoverLetter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // BUG-315: a letter can exist without a resume, and survives the resume being deleted.
  resumeId  String?  @unique
  resume    Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  title     String
  body      String
  // Batch 2: auto cover letter from a finalized resume. source: "ai" | "template" | null (hand-written).
  tone               String    @default("professional")
  targetRole         String?
  targetCompany      String?
  jobDescription     String?
  source             String?
  generatedAt        DateTime?
  // The linked resume was edited after this letter was generated (shows "regenerate?").
  resumeUpdatedAfter Boolean   @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Template {
  id           String  @id
  name         String
  department   String
  layoutKey    String
  accentColor  String
  fontFamily   String
  isPremium    Boolean @default(false)
  previewLabel String
}

/** Admin-uploaded landing templates (PDF + preview) */
model LandingTemplate {
  id          String   @id @default(cuid())
  name        String
  blurb       String   @default("")
  department  String
  layoutKey   String   @default("high-performer")
  accentColor String   @default("#1c2b42")
  fontFamily  String   @default("Lato")
  hasPhoto    Boolean  @default(true)
  columns     String   @default("double")
  pdfPath     String
  previewPath String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([department])
}

model Job {
  id           String           @id @default(cuid())
  title        String
  company      String
  location     String
  remote       Boolean          @default(false)
  department   String
  description  String
  applyUrl     String
  keywords     String[]
  createdAt    DateTime         @default(now())
  applications JobApplication[]
}

model JobApplication {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage     String   @default("recommended")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
}

model AutoApplyConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     String[]
  locations String[]
  remote    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model AutoApplyCredit {
  id         String @id @default(cuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  remaining  Int    @default(50)
  processing Int    @default(0)
  applied    Int    @default(0)
}

/// Admin console team (Manage Team). Access is granted to the signed-in user whose email matches an
/// ACTIVE / INVITED row; permissions default from the role and can be overridden per member.
model AdminTeamMember {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// SUPER_ADMIN | OPERATIONS | SUPPORT | ANALYST | CUSTOM
  role         String    @default("ANALYST")
  canRead      Boolean   @default(true)
  canWrite     Boolean   @default(false)
  canDelete    Boolean   @default(false)
  canBilling   Boolean   @default(false)
  canSystem    Boolean   @default(false)
  /// ACTIVE | INVITED | DISABLED
  status       String    @default("INVITED")
  invitedBy    String?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

/// Billing invoices (filled by the payment provider webhook once Paddle / Safepay is connected).
model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  userId        String?
  userEmail     String
  plan          String    @default("PRO")
  amountCents   Int
  currency      String    @default("USD")
  /// PAID | PENDING | FAILED | REFUNDED
  status        String    @default("PENDING")
  provider      String?
  providerRef   String?
  issuedAt      DateTime  @default(now())
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([status])
  @@index([issuedAt])
  @@index([userId])
}

/// Contact-form submissions (leads). The email to ADMIN_EMAIL is still sent as before.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  ip        String?
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

/// Usage counters that have no table of their own (e.g. kind = "audio_job").
model UsageEvent {
  id        String   @id @default(cuid())
  kind      String
  userId    String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// API request totals per hour (UTC bucket), flushed from memory every minute; drives the error rate.
model RequestStat {
  bucket    DateTime @id
  total     Int      @default(0)
  errors    Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// One noise-remover job (row written when the job is queued, updated when it ends). Files are never stored here.
model AudioJob {
  id           String    @id
  userId       String?
  userEmail    String?
  /// voice | music | ... (the mode the user picked)
  mode         String
  strength     Int?
  outputFormat String?
  /// file extension of the upload (the file name itself is not kept)
  inputExt     String?
  sizeBytes    Int       @default(0)
  durationSec  Float?
  /// queued | processing | done | failed | canceled
  status       String    @default("queued")
  errorCode    String?
  engine       String?
  processingMs Int?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([userId])
}
