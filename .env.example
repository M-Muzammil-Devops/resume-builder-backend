# Single env file for the Resume Builder backend. Copy to .env (chmod 600, git-ignored).
# Used by: systemd EnvironmentFile, docker compose --env-file, deploy/deploy.sh and deploy/update.sh.
# Values containing spaces or <> must be wrapped in single quotes, e.g. SMTP_FROM='"Name" <you@example.com>'.

DATABASE_URL=postgresql://resume:resume@localhost:5432/resume_builder?schema=public
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_DIR=uploads
LOG_LEVEL=info

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Admin bootstrap (seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Redis cache. Host backend uses localhost; the compose backend overrides this to redis://redis:6379.
# Set REDIS_ENABLED=false to run without cache.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_TTL_SECONDS=300

# PDF export (optional). Auto-detects Chrome/Edge if unset.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Public site URL used in verification and password-reset emails.
# APP_URL=https://your-domain.example

# Internal URL the PDF renderer opens for /print/:id (server-to-server, not public).
# FRONTEND_URL=http://127.0.0.1:3000

# SMTP for verification and password reset. Leave SMTP_HOST empty to skip delivery.
# AWS SES accepts the same values as SMTP_ADDRESS / SMTP_USERNAME / SMTP_PASSWORD / MAIL_FROM.
# SMTP_HOST=email-smtp.us-east-2.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=you@gmail.com
# SMTP_REQUIRE_TLS=true
# --- Sign-in with Google / Facebook (optional). A button shows only when both keys of a provider are set. ---
# Register these exact redirect URIs with the provider (OAUTH_REDIRECT_BASE + /rb-api/auth/oauth/<provider>/callback):
#   Google:   https://devops.elevatesofts.com/rb-api/auth/oauth/google/callback
#   Facebook: https://devops.elevatesofts.com/rb-api/auth/oauth/facebook/callback
# Email magic-code sign-in needs only the SMTP settings below.
OAUTH_REDIRECT_BASE=https://devops.elevatesofts.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Audio tool: accepted files per user per hour (admin/owner exempt; canceled/failed jobs refunded)
AUDIO_HOURLY_LIMIT=20

# --- Production (Docker) ---
# Signs the 5-minute audio preview links; random per process when unset.
# AUDIO_PREVIEW_SECRET=
# Internal URL Puppeteer opens for PDF export (compose: http://frontend:3000).
# PRINT_BASE_URL=http://127.0.0.1:3000
# Folder with the frontend's public/ assets (template photos, fonts) used by exports.
# FRONTEND_PUBLIC_DIR=../resume-builder-frontend/public
# Production compose settings live in deploy/.env (see deploy/.env.example and deploy/DEPLOY.md).

# ---- Server / deploy keys (from the former deploy/.env.example) ----
# -----------------------------------------------------------------------------
# Resume Builder staging settings (deploy/.env).
# deploy.sh also writes deploy/backend.env (the backend service's EnvironmentFile) from this file.
# deploy.sh copies this file to deploy/.env on the first run, fills every EMPTY secret below with a
# strong random value and never prints them. Edit deploy/.env (not this file) and re-run deploy.sh.
# Never commit deploy/.env.
# -----------------------------------------------------------------------------

# Public URL of the site. Empty = http://<server public IP> (detected), or https://<DOMAIN> with --domain.
APP_URL=
# Domain + e-mail for Let's Encrypt via host certbot (also settable with --domain / --email).
DOMAIN=
LETSENCRYPT_EMAIL=

# Loopback ports (127.0.0.1 only): frontend container + backend host service (both behind the host
# nginx), postgres + redis containers (used by the host backend). Change any that is already taken.
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Source folders (absolute paths; deploy.sh fills these in).
BACKEND_DIR=
FRONTEND_DIR=
IMAGE_TAG=latest

# Database / cache (containers, loopback only).
POSTGRES_USER=resume
POSTGRES_DB=resume_builder
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Demo user + /auth/demo endpoint: OFF unless true (dev only). Needs DEMO_PASSWORD (min 8 chars) when enabled.
SEED_DEMO_USER=false
DEMO_PASSWORD=

# Auth secrets (>= 32 chars; generated).
AUDIO_PREVIEW_SECRET=

# Admin account created by the first-run seed. ADMIN_PASSWORD is generated when empty.

# AI (optional)


# SMTP for verification / password-reset mail (leave SMTP_HOST empty to disable).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REQUIRE_TLS=true

# Audio tool
AUDIO_ENGINE=auto
AUDIO_DEVICE=cpu
AUDIO_MAX_MB=100
AUDIO_MAX_SECONDS=1200

# Users & Activity: offline GeoIP (npm run geoip:update) and trusted proxy hops
GEOIP_DB_PATH=data/geoip/dbip-city-lite.mmdb
GEOIP_IDLE_MS=600000
TRUST_PROXY=127.0.0.1,::1
# Google Analytics 4 for the frontend build (empty = no analytics scripts). Loaded only after cookie consent.
NEXT_PUBLIC_GA_ID=
