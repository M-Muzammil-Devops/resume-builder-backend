# HTTPS with a Let's Encrypt certificate for ${SERVER_NAME}; port 80 only answers ACME and redirects.
include /etc/nginx/snippets/http-common.conf;

# HTTPS: pass the app's CSP through unchanged; only the internal :8080 print endpoint drops the upgrade.
map $server_port $rb_csp {
    8080    $rb_csp_noupgrade;
    default $upstream_http_content_security_policy;
}

server {
    listen 80 default_server;
    server_name ${SERVER_NAME};

    include /etc/nginx/snippets/acme.conf;
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/app.conf;
}

# Internal-only endpoint (port 8080 is NOT published): the backend's PDF renderer (Chromium) opens
# /print/:id here (PRINT_BASE_URL=http://nginx:8080), with the same /rb-api routing as the public site.
server {
    listen 8080;
    server_name _;
    include /etc/nginx/snippets/app.conf;
}
